---
import '@fontsource/nunito/400.css';
import '@fontsource/nunito/500.css';
import '@fontsource/nunito/600.css';
import '@fontsource/nunito/700.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/500-italic.css';

import { createProjectRelativeUrl } from '@/config/site-branding';

const adminConfigUrl = createProjectRelativeUrl('admin/config.yml');
const favicon16Url = createProjectRelativeUrl('favicon-16x16.png');
const favicon32Url = createProjectRelativeUrl('favicon-32x32.png');
const faviconIcoUrl = createProjectRelativeUrl('favicon.ico');
const appleTouchIconUrl = createProjectRelativeUrl('apple-touch-icon.png');
const webManifestUrl = createProjectRelativeUrl('site.webmanifest');
const browserConfigUrl = createProjectRelativeUrl('browserconfig.xml');
const adminStyleUrl = createProjectRelativeUrl('admin/admin.css');
const previewStyleUrl = createProjectRelativeUrl('admin/preview.css');
const projectBaseUrl = createProjectRelativeUrl('');
---

<!doctype html>
<html lang="el">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#C7392E" />
    <meta name="msapplication-TileColor" content="#C7392E" />
    <meta name="msapplication-config" content={browserConfigUrl} />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIconUrl} />
    <link rel="icon" type="image/png" sizes="32x32" href={favicon32Url} />
    <link rel="icon" type="image/png" sizes="16x16" href={favicon16Url} />
    <link rel="icon" href={faviconIcoUrl} />
    <link rel="manifest" href={webManifestUrl} />
    <link rel="stylesheet" href={adminStyleUrl} />
    <link rel="cms-config-url" type="text/yaml" href={adminConfigUrl} />
    <title>Ateleia CMS</title>
  </head>
  <body>
    <div id="nc-root"></div>

    <script is:inline>
      window.CMS_MANUAL_INIT = true;
    </script>
    <script src="https://unpkg.com/decap-cms@3.10.1/dist/decap-cms.js"></script>
    <script is:inline define:vars={{ previewStyleUrl, projectBaseUrl }}>
      const bootstrapAdmin = () => {
        if (!window.CMS || !window.h || !window.createClass || !window.initCMS) {
          window.setTimeout(bootstrapAdmin, 30);
          return;
        }

        const h = window.h;
        const defaultNavigationLabels = [
          'Τι είναι',
          'Σε ποιους απευθύνεται',
          'Σχετικά',
          'Υπηρεσίες',
          'Επικοινωνία',
        ];

        const toArray = (value) => {
          if (!value) {
            return [];
          }

          if (typeof value.toJS === 'function') {
            return value.toJS();
          }

          return Array.isArray(value) ? value : [];
        };

        const toPlainObject = (value) => JSON.parse(JSON.stringify(value ?? {}));

        const deepMerge = (target, source) => {
          Object.entries(source).forEach(([key, value]) => {
            if (Array.isArray(value)) {
              target[key] = value.slice();
              return;
            }

            if (value && typeof value === 'object') {
              const nextTarget =
                target[key] && typeof target[key] === 'object' && !Array.isArray(target[key])
                  ? target[key]
                  : {};
              target[key] = deepMerge(nextTarget, value);
              return;
            }

            target[key] = value;
          });

          return target;
        };

        const toText = (value, fallback = '') => {
          if (typeof value === 'string') {
            const normalized = value.trim();
            return normalized.length > 0 ? normalized : fallback;
          }

          if (value === null || value === undefined) {
            return fallback;
          }

          const normalized = String(value).trim();
          return normalized.length > 0 ? normalized : fallback;
        };

        const getEntryText = (entry, path, fallback = '') => toText(entry?.getIn?.(path), fallback);

        const toUppercaseWithoutGreekTonos = (value, fallback = '') =>
          toText(value, fallback)
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .toUpperCase();

        const joinNonEmpty = (values, separator = ' · ') =>
          toArray(values).filter(Boolean).join(separator);

        const createPreviewImageUrl = (value, getAsset) => {
          const source = toText(value, '');

          if (!source) {
            return '';
          }

          const asset = typeof getAsset === 'function' ? getAsset(source) : source;
          const assetUrl = toText(asset?.toString?.() ?? asset, source);

          if (/^(?:https?:|data:|blob:|\/)/.test(assetUrl)) {
            return assetUrl;
          }

          return `${projectBaseUrl}${assetUrl.replace(/^public\//, '')}`;
        };

        const renderPreview = (kind, content) =>
          h('section', { className: `decap-preview decap-preview--${kind}` }, [
            h('div', { className: 'decap-preview__frame', key: 'frame' }, content),
          ]);

        const renderSiteChrome = ({
          brandName = 'Ατέλεια',
          brandSubtitle = 'Θεραπεία μέσω τέχνης',
          navigationLabels = defaultNavigationLabels,
          actionLabel = 'Κλείστε ραντεβού',
        } = {}) =>
          h('header', { className: 'decap-preview__sitechrome' }, [
            h('div', { className: 'decap-preview__brand', key: 'brand' }, [
              h('span', { className: 'decap-preview__brand-mark', key: 'mark', 'aria-hidden': 'true' }),
              h('div', { className: 'decap-preview__brand-copy', key: 'copy' }, [
                h('p', { className: 'decap-preview__brand-name', key: 'name' }, brandName),
                h('p', { className: 'decap-preview__brand-subtitle', key: 'subtitle' }, brandSubtitle),
              ]),
            ]),
            h(
              'nav',
              { className: 'decap-preview__nav', key: 'nav', 'aria-label': 'Πλοήγηση προεπισκόπησης' },
              navigationLabels.map((label, index) =>
                h('span', { className: 'decap-preview__nav-chip', key: `nav-${index}` }, label),
              ),
            ),
            h('span', { className: 'decap-preview__button decap-preview__button--primary', key: 'cta' }, actionLabel),
          ]);

        const renderSiteGlobalPreview = (entryData) => {
          const seo = entryData.get('seo');
          const navigation = entryData.get('navigation');
          const footer = entryData.get('footer');
          const brandName = getEntryText(entryData, ['brandName'], 'Ατέλεια');
          const brandSubtitle = getEntryText(entryData, ['brandSubtitle'], 'Θεραπεία μέσω τέχνης');
          const navigationLabels = [
            getEntryText(navigation, ['whatIs'], 'Τι είναι'),
            getEntryText(navigation, ['whoIsItFor'], 'Σε ποιους απευθύνεται'),
            getEntryText(navigation, ['about'], 'Σχετικά'),
            getEntryText(navigation, ['services'], 'Υπηρεσίες'),
            getEntryText(navigation, ['contact'], 'Επικοινωνία'),
          ];

          return renderPreview('site-global', [
            renderSiteChrome({ brandName, brandSubtitle, navigationLabels }),
            h('div', { className: 'decap-preview__section decap-preview__section--site-global', key: 'section' }, [
              h('article', { className: 'decap-preview__card decap-preview__card--heroic', key: 'seo' }, [
                h('p', { className: 'decap-preview__overline', key: 'overline' }, 'GOOGLE PREVIEW'),
                h('h1', { className: 'decap-preview__headline', key: 'title' }, getEntryText(seo, ['pageTitle'], brandName)),
                h(
                  'p',
                  { className: 'decap-preview__copy', key: 'description' },
                  getEntryText(seo, ['pageDescription'], 'Σύντομη περιγραφή για το Google snippet και τις κοινοποιήσεις.'),
                ),
                h('div', { className: 'decap-preview__stack', key: 'stack' }, [
                  h('div', { className: 'decap-preview__soft-card', key: 'social-title' }, [
                    h('p', { className: 'decap-preview__label', key: 'label' }, 'Κοινοποίηση'),
                    h('p', { className: 'decap-preview__copy decap-preview__copy--tight', key: 'value' }, getEntryText(seo, ['openGraphTitle'], brandName)),
                  ]),
                  h('div', { className: 'decap-preview__soft-card', key: 'social-copy' }, [
                    h('p', { className: 'decap-preview__label', key: 'label' }, 'Περιγραφή'),
                    h('p', { className: 'decap-preview__copy decap-preview__copy--tight', key: 'value' }, getEntryText(seo, ['openGraphDescription'], getEntryText(seo, ['pageDescription'], ''))),
                  ]),
                ]),
              ]),
              h('div', { className: 'decap-preview__grid decap-preview__grid--site-global', key: 'grid' }, [
                h('article', { className: 'decap-preview__card', key: 'navigation' }, [
                  h('p', { className: 'decap-preview__overline', key: 'overline' }, 'MENU'),
                  h(
                    'div',
                    { className: 'decap-preview__chip-row', key: 'chips' },
                    navigationLabels.map((label, index) =>
                      h('span', { className: 'decap-preview__chip', key: `${label}-${index}` }, label),
                    ),
                  ),
                ]),
                h('article', { className: 'decap-preview__card', key: 'footer' }, [
                  h('p', { className: 'decap-preview__overline', key: 'overline' }, 'FOOTER'),
                  h('p', { className: 'decap-preview__copy decap-preview__copy--tight', key: 'copyright' }, getEntryText(footer, ['copyright'], `${brandName} · ${brandSubtitle}`)),
                  h('p', { className: 'decap-preview__copy decap-preview__copy--tight', key: 'rights' }, getEntryText(footer, ['rightsReserved'], 'All rights reserved.')),
                  h('div', { className: 'decap-preview__meta-row', key: 'links' }, [
                    h('span', { className: 'decap-preview__meta-pill', key: 'credits' }, getEntryText(footer, ['creditsLabel'], 'Credits')),
                    h('span', { className: 'decap-preview__meta-pill', key: 'legal' }, getEntryText(footer, ['legalLabel'], 'Legal')),
                  ]),
                ]),
              ]),
            ]),
          ]);
        };

        const renderHeroPreview = (entryData) =>
          renderPreview('hero', [
            renderSiteChrome({
              actionLabel: getEntryText(entryData, ['primaryCta'], 'Κλείστε ραντεβού'),
            }),
            h('section', { className: 'decap-preview__hero', key: 'hero' }, [
              h('div', { className: 'decap-preview__hero-copy', key: 'copy' }, [
                h(
                  'p',
                  { className: 'decap-preview__overline', key: 'eyebrow' },
                  toUppercaseWithoutGreekTonos(getEntryText(entryData, ['spotlightEyebrow'], 'Therapeutic Atelier')),
                ),
                h('h1', { className: 'decap-preview__hero-title', key: 'headline' }, getEntryText(entryData, ['headline'], 'Θεραπεία μέσω τέχνης')),
                h('p', { className: 'decap-preview__hero-copytext', key: 'subheadline' }, getEntryText(entryData, ['subheadline'], 'Ενας ασφαλής και δημιουργικός χώρος.')),
                h('div', { className: 'decap-preview__button-row', key: 'actions' }, [
                  h('span', { className: 'decap-preview__button decap-preview__button--primary', key: 'primary' }, getEntryText(entryData, ['primaryCta'], 'Κλείστε ραντεβού')),
                  h('span', { className: 'decap-preview__button decap-preview__button--secondary', key: 'secondary' }, getEntryText(entryData, ['secondaryCta'], 'Στείλτε μήνυμα')),
                ]),
              ]),
              h('aside', { className: 'decap-preview__hero-panel', key: 'panel' }, [
                h('p', { className: 'decap-preview__label', key: 'label' }, 'Θεραπευτική αρχή'),
                h('blockquote', { className: 'decap-preview__quote', key: 'quote' }, `«${getEntryText(entryData, ['subheadline'], 'Ενας ασφαλής και δημιουργικός χώρος.')}»`),
                h(
                  'div',
                  { className: 'decap-preview__meta-row', key: 'meta' },
                  [
                    getEntryText(entryData, ['primaryCta'], 'Κλείστε ραντεβού'),
                    getEntryText(entryData, ['secondaryCta'], 'Στείλτε μήνυμα'),
                  ].map((value, index) => h('span', { className: 'decap-preview__meta-pill', key: `pill-${index}` }, value)),
                ),
              ]),
            ]),
          ]);

        const renderWhatIsPreview = (entryData) => {
          const paragraphs = toArray(entryData.get('paragraphs'));

          return renderPreview('what-is', [
            h('section', { className: 'decap-preview__section', key: 'section' }, [
              h('p', { className: 'decap-preview__overline', key: 'overline' }, toUppercaseWithoutGreekTonos('Τι είναι')),
              h('h1', { className: 'decap-preview__headline', key: 'title' }, getEntryText(entryData, ['title'], 'Τι είναι η Θεραπεία μέσω τέχνης;')),
              h('div', { className: 'decap-preview__grid decap-preview__grid--split', key: 'grid' }, [
                h('article', { className: 'decap-preview__card decap-preview__card--quote', key: 'quote' }, [
                  h('p', { className: 'decap-preview__quote', key: 'text' }, `«${getEntryText(entryData, ['pullQuote', 'text'], 'Το κείμενο του αποσπάσματος.') }»`),
                  h(
                    'p',
                    { className: 'decap-preview__label', key: 'attribution' },
                    toUppercaseWithoutGreekTonos(getEntryText(entryData, ['pullQuote', 'attribution'], 'Υπογραφή')),
                  ),
                ]),
                h('div', { className: 'decap-preview__stack', key: 'body' }, [
                  ...paragraphs.map((paragraph, index) =>
                    h('p', { className: 'decap-preview__copy', key: `paragraph-${index}` }, toText(paragraph, '')),
                  ),
                  h('article', { className: 'decap-preview__soft-card', key: 'note' }, [
                    h(
                      'p',
                      { className: 'decap-preview__label', key: 'note-label' },
                      toUppercaseWithoutGreekTonos(getEntryText(entryData, ['practiceNoteLabel'], 'Πρακτική σημείωση')),
                    ),
                    h('p', { className: 'decap-preview__copy decap-preview__copy--tight', key: 'note-copy' }, getEntryText(entryData, ['practiceNote'], 'Σταθερό θεραπευτικό πλαίσιο και εμπιστευτικότητα.')),
                  ]),
                ]),
              ]),
            ]),
          ]);
        };

        const renderWhoIsItForPreview = (entryData) => {
          const items = toArray(entryData.get('items'));

          return renderPreview('who-is-it-for', [
            h('section', { className: 'decap-preview__section', key: 'section' }, [
              h(
                'p',
                { className: 'decap-preview__overline', key: 'overline' },
                toUppercaseWithoutGreekTonos('Σε ποιους απευθύνεται'),
              ),
              h('h1', { className: 'decap-preview__headline', key: 'title' }, getEntryText(entryData, ['title'], 'Σε ποιους απευθύνεται')),
              h(
                'div',
                { className: 'decap-preview__list-grid', key: 'items' },
                items.map((item, index) =>
                  h('article', { className: 'decap-preview__list-card', key: `item-${index}` }, [
                    h('span', { className: 'decap-preview__list-dot', key: 'dot', 'aria-hidden': 'true' }),
                    h('p', { className: 'decap-preview__copy decap-preview__copy--tight', key: 'copy' }, toText(item, '')),
                  ]),
                ),
              ),
            ]),
          ]);
        };

        const renderAboutPreview = (entryData, getAsset) => {
          const bio = toArray(entryData.get('bio'));
          const portrait = entryData.get('portrait');
          const portraitImageUrl = createPreviewImageUrl(portrait?.get?.('src'), getAsset);
          const portraitCaption = getEntryText(portrait, ['caption'], '');
          const portraitAlt = getEntryText(portrait, ['alt'], portraitCaption || getEntryText(entryData, ['title'], 'Σχετικά'));

          return renderPreview('about', [
            h('section', { className: 'decap-preview__section', key: 'section' }, [
              h('p', { className: 'decap-preview__overline', key: 'overline' }, toUppercaseWithoutGreekTonos('Σχετικά')),
              h('h1', { className: 'decap-preview__headline', key: 'title' }, getEntryText(entryData, ['title'], 'Σχετικά')),
              h('div', { className: 'decap-preview__grid decap-preview__grid--split', key: 'grid' }, [
                h('div', { className: 'decap-preview__stack', key: 'story' }, [
                  ...bio.map((paragraph, index) =>
                    h('p', { className: 'decap-preview__copy', key: `paragraph-${index}` }, toText(paragraph, '')),
                  ),
                ]),
                h('div', { className: 'decap-preview__stack', key: 'side' }, [
                  portraitImageUrl
                    ? h('figure', { className: 'decap-preview__portrait', key: 'portrait' }, [
                        h('img', { className: 'decap-preview__portrait-image', src: portraitImageUrl, alt: portraitAlt, key: 'image' }),
                        portraitCaption
                          ? h('figcaption', { className: 'decap-preview__portrait-caption', key: 'caption' }, portraitCaption)
                          : null,
                      ])
                    : null,
                  h('article', { className: 'decap-preview__card decap-preview__card--quote', key: 'quote' }, [
                    h('p', { className: 'decap-preview__quote', key: 'pull-quote' }, `«${getEntryText(entryData, ['pullQuote'], 'Το κεντρικό απόσπασμα της ενότητας.')}»`),
                  ]),
                  h('article', { className: 'decap-preview__card decap-preview__card--soft', key: 'approach' }, [
                    h('p', { className: 'decap-preview__overline', key: 'overline' }, 'ΠΡΟΣΕΓΓΙΣΗ'),
                    h('h2', { className: 'decap-preview__subheading', key: 'title' }, getEntryText(entryData, ['approach', 'title'], 'Θεραπευτική προσέγγιση')),
                    h('p', { className: 'decap-preview__copy', key: 'copy' }, getEntryText(entryData, ['approach', 'description'], 'Περιγραφή θεραπευτικής προσέγγισης.')),
                  ]),
                ]),
              ]),
            ]),
          ]);
        };

        const renderServicesPreview = (entryData) => {
          const services = toArray(entryData.get('services'));
          const frequentlyAskedQuestions = toArray(entryData.get('frequentlyAskedQuestions'));
          const audienceLabel = getEntryText(entryData, ['audienceLabel'], 'Ιδανικό για');
          const expectationsLabel = getEntryText(entryData, ['expectationsLabel'], 'Τι να περιμένετε');

          return renderPreview('services', [
            h('section', { className: 'decap-preview__section', key: 'section' }, [
              h('p', { className: 'decap-preview__overline', key: 'overline' }, toUppercaseWithoutGreekTonos('Υπηρεσίες')),
              h('h1', { className: 'decap-preview__headline', key: 'title' }, getEntryText(entryData, ['title'], 'Υπηρεσίες')),
              h(
                'div',
                { className: 'decap-preview__service-grid', key: 'services' },
                services.length > 0
                  ? services.map((service, index) => {
                      const idealFor = toArray(service?.idealFor);
                      const whatToExpect = toArray(service?.whatToExpect);
                      const meta = joinNonEmpty([toText(service?.format, ''), toText(service?.duration, '')]);

                      return h('article', { className: 'decap-preview__service-card', key: `service-${index}` }, [
                        h('h2', { className: 'decap-preview__subheading', key: 'title' }, toText(service?.title, 'Νέα υπηρεσία')),
                        h('p', { className: 'decap-preview__copy', key: 'description' }, toText(service?.description, 'Σύντομη περιγραφή υπηρεσίας.')),
                        meta
                          ? h('p', { className: 'decap-preview__service-meta', key: 'meta' }, meta)
                          : null,
                        idealFor.length > 0
                          ? h('div', { className: 'decap-preview__stack', key: 'ideal-for' }, [
                              h('p', { className: 'decap-preview__label', key: 'label' }, audienceLabel),
                              h(
                                'div',
                                { className: 'decap-preview__chip-row', key: 'chips' },
                                idealFor.map((item, itemIndex) =>
                                  h('span', { className: 'decap-preview__chip', key: `ideal-${itemIndex}` }, toText(item?.value ?? item, '')),
                                ),
                              ),
                            ])
                          : null,
                        whatToExpect.length > 0
                          ? h('div', { className: 'decap-preview__soft-card', key: 'expectations' }, [
                              h('p', { className: 'decap-preview__label', key: 'label' }, expectationsLabel),
                              h(
                                'ul',
                                { className: 'decap-preview__bullet-list', key: 'list' },
                                whatToExpect.map((item, itemIndex) =>
                                  h('li', { className: 'decap-preview__bullet-item', key: `expectation-${itemIndex}` }, toText(item?.value ?? item, '')),
                                ),
                              ),
                            ])
                          : null,
                      ].filter(Boolean));
                    })
                  : [
                      h(
                        'div',
                        { className: 'decap-preview__empty', key: 'empty' },
                        'Προσθέστε υπηρεσίες για να εμφανιστούν εδώ.',
                      ),
                    ],
              ),
              h('div', { className: 'decap-preview__stack', key: 'faq' }, [
                h(
                  'h2',
                  { className: 'decap-preview__subheading', key: 'faq-title' },
                  getEntryText(entryData, ['frequentlyAskedQuestionsTitle'], 'Συχνές ερωτήσεις'),
                ),
                frequentlyAskedQuestions.length > 0
                  ? h(
                      'div',
                      { className: 'decap-preview__stack', key: 'faq-list' },
                      frequentlyAskedQuestions.map((faq, index) =>
                        h('article', { className: 'decap-preview__soft-card', key: `faq-${index}` }, [
                          h('p', { className: 'decap-preview__label', key: 'question' }, toText(faq?.question, 'Ερώτηση')),
                          h('p', { className: 'decap-preview__copy decap-preview__copy--tight', key: 'answer' }, toText(faq?.answer, 'Απάντηση')),
                        ]),
                      ),
                    )
                  : null,
              ]),
            ]),
          ]);
        };

        const renderAnnouncementsPreview = (entryData) => {
          const kindLabels = entryData.get('kindLabels');
          const announcements = toArray(entryData.get('announcements')).filter(
            (announcement) => announcement?.isPublished !== false,
          );

          return renderPreview('announcements', [
            h('section', { className: 'decap-preview__section', key: 'section' }, [
              h('p', { className: 'decap-preview__overline', key: 'overline' }, toUppercaseWithoutGreekTonos('Νέα & ανακοινώσεις')),
              h('h1', { className: 'decap-preview__headline', key: 'title' }, getEntryText(entryData, ['title'], 'Νέα & ανακοινώσεις')),
              h('p', { className: 'decap-preview__copy', key: 'intro' }, getEntryText(entryData, ['intro'], 'Σύντομες ενημερώσεις και νέες δράσεις.')),
              h(
                'div',
                { className: 'decap-preview__announcement-grid', key: 'cards' },
                announcements.length > 0
                  ? announcements.map((announcement, index) => {
                      const kind = toText(announcement?.kind, 'announcement');
                      const labelMap = {
                        workshop: getEntryText(kindLabels, ['workshop'], 'Εργαστήριο'),
                        group: getEntryText(kindLabels, ['group'], 'Ομάδα'),
                        announcement: getEntryText(kindLabels, ['announcement'], 'Ανακοίνωση'),
                      };
                      const badgeClass = `decap-preview__badge decap-preview__badge--${kind}`;

                      return h('article', { className: 'decap-preview__announcement-card', key: `announcement-${index}` }, [
                        h('div', { className: 'decap-preview__announcement-meta', key: 'meta' }, [
                          toText(announcement?.dateLabel, '')
                            ? h('p', { className: 'decap-preview__label', key: 'date' }, toText(announcement?.dateLabel, ''))
                            : null,
                          h('span', { className: badgeClass, key: 'kind' }, labelMap[kind] ?? labelMap.announcement),
                        ].filter(Boolean)),
                        h('h2', { className: 'decap-preview__subheading', key: 'title' }, toText(announcement?.title, 'Νέα ανακοίνωση')),
                        h('p', { className: 'decap-preview__copy', key: 'summary' }, toText(announcement?.summary, 'Σύντομη περιγραφή ανακοίνωσης.')),
                        toText(announcement?.callToActionLabel, '')
                          ? h('p', { className: 'decap-preview__announcement-cta', key: 'cta' }, `${toText(announcement?.callToActionLabel, '')} ↗`)
                          : null,
                      ].filter(Boolean));
                    })
                  : [
                      h(
                        'div',
                        { className: 'decap-preview__empty', key: 'empty' },
                        'Δεν υπάρχουν δημοσιευμένες ανακοινώσεις.',
                      ),
                    ],
              ),
            ]),
          ]);
        };

        const renderContactPreview = (entryData) => {
          const contactItems = toArray(entryData.get('contactItems'));
          const formLabels = entryData.get('formLabels');
          const formPlaceholders = entryData.get('formPlaceholders');

          return renderPreview('contact', [
            h('section', { className: 'decap-preview__section', key: 'section' }, [
              h('p', { className: 'decap-preview__overline', key: 'overline' }, toUppercaseWithoutGreekTonos('Επικοινωνία')),
              h('h1', { className: 'decap-preview__headline', key: 'title' }, getEntryText(entryData, ['title'], 'Επικοινωνία')),
              h('div', { className: 'decap-preview__grid decap-preview__grid--split', key: 'grid' }, [
                h('div', { className: 'decap-preview__stack', key: 'details' }, [
                  h('p', { className: 'decap-preview__copy', key: 'description' }, getEntryText(entryData, ['description'], 'Επικοινωνήστε για ραντεβού ή περισσότερες πληροφορίες.')),
                  h(
                    'div',
                    { className: 'decap-preview__stack', key: 'items' },
                    contactItems.map((contactItem, index) =>
                      h('article', { className: 'decap-preview__soft-card', key: `contact-${index}` }, [
                        h('p', { className: 'decap-preview__label', key: 'label' }, toText(contactItem?.label, 'Στοιχείο')),
                        h('p', { className: 'decap-preview__copy decap-preview__copy--tight', key: 'value' }, toText(contactItem?.value, '')),
                      ]),
                    ),
                  ),
                  h('p', { className: 'decap-preview__copy decap-preview__copy--tight', key: 'availability' }, getEntryText(entryData, ['availabilityNote'], 'Συνήθως απαντώ εντός λίγων εργάσιμων ημερών.')),
                ]),
                h('article', { className: 'decap-preview__form-card', key: 'form' }, [
                  h('div', { className: 'decap-preview__form-field', key: 'name' }, [
                    h('span', { className: 'decap-preview__label', key: 'label' }, getEntryText(formLabels, ['name'], 'Ονομα')),
                    h('span', { className: 'decap-preview__form-value', key: 'value' }, getEntryText(formPlaceholders, ['name'], 'Το ονοματεπώνυμό σας')),
                  ]),
                  h('div', { className: 'decap-preview__form-field', key: 'email' }, [
                    h('span', { className: 'decap-preview__label', key: 'label' }, getEntryText(formLabels, ['email'], 'Email')),
                    h('span', { className: 'decap-preview__form-value', key: 'value' }, getEntryText(formPlaceholders, ['email'], 'name@example.com')),
                  ]),
                  h('div', { className: 'decap-preview__form-field decap-preview__form-field--textarea', key: 'message' }, [
                    h('span', { className: 'decap-preview__label', key: 'label' }, getEntryText(formLabels, ['message'], 'Μήνυμα')),
                    h('span', { className: 'decap-preview__form-value', key: 'value' }, getEntryText(formPlaceholders, ['message'], 'Πείτε μας λίγο τι χρειάζεστε.')),
                  ]),
                  h('p', { className: 'decap-preview__copy decap-preview__copy--tight', key: 'consent' }, getEntryText(formLabels, ['consent'], 'Συμφωνώ με την επεξεργασία των στοιχείων μου για απάντηση στο μήνυμα.')),
                  h('span', { className: 'decap-preview__button decap-preview__button--primary', key: 'submit' }, getEntryText(formLabels, ['submit'], 'Αποστολή μηνύματος')),
                  h('p', { className: 'decap-preview__form-note', key: 'privacy' }, getEntryText(entryData, ['privacyNote'], 'Η φόρμα χρησιμοποιείται μόνο για την επικοινωνία σας με την Ατέλεια.')),
                ]),
              ]),
            ]),
          ]);
        };

        const registerGreekLocale = () => {
          const englishLocale = toPlainObject(window.CMS.getLocale('en'));
          const greekLocale = deepMerge(englishLocale, {
            app: {
              header: {
                content: 'Περιεχόμενο',
                media: 'Πολυμέσα',
                quickAdd: 'Γρήγορη προσθήκη',
              },
            },
            collection: {
              sidebar: {
                collections: 'Συλλογές',
                allCollections: 'Ολες οι συλλογές',
                searchAll: 'Αναζήτηση σε όλα',
                searchIn: 'Αναζήτηση σε',
              },
              collectionTop: {
                newButton: 'Προσθέστε %{collectionLabel}',
                sortBy: 'Ταξινόμηση',
                viewAs: 'Προβολή',
                viewAsList: 'Λίστα',
                viewAsGrid: 'Πλέγμα',
              },
              entries: {
                loadingEntries: 'Φόρτωση καταχωρίσεων...',
                cachingEntries: 'Προετοιμασία καταχωρίσεων...',
                noEntries: 'Δεν υπάρχουν καταχωρίσεις',
              },
            },
            editor: {
              editor: {
                loadingEntry: 'Φόρτωση καταχώρισης...',
              },
              editorControl: {
                field: {
                  optional: 'προαιρετικό',
                },
              },
              editorControlPane: {
                widget: {
                  rangeCount:
                    'Το πεδίο %{fieldLabel} πρέπει να περιλαμβάνει από %{minCount} έως %{maxCount} στοιχεία.',
                  rangeCountExact:
                    'Το πεδίο %{fieldLabel} πρέπει να περιλαμβάνει ακριβώς %{count} στοιχεία.',
                  rangeMin:
                    'Το πεδίο %{fieldLabel} πρέπει να περιλαμβάνει τουλάχιστον %{minCount} στοιχεία.',
                  rangeMax:
                    'Το πεδίο %{fieldLabel} πρέπει να περιλαμβάνει έως %{maxCount} στοιχεία.',
                },
              },
              editorToolbar: {
                publishAndCreateNew: 'Δημοσίευση και νέα καταχώριση',
                deleteUnpublishedChanges: 'Διαγραφή αδημοσίευτων αλλαγών',
                deleteUnpublishedEntry: 'Διαγραφή αδημοσίευτης καταχώρισης',
                deletePublishedEntry: 'Διαγραφή δημοσιευμένης καταχώρισης',
                deleteEntry: 'Διαγραφή καταχώρισης',
              },
              editorWidgets: {
                list: {
                  add: 'Προσθέστε %{item}',
                  addType: 'Προσθέστε %{item}',
                },
                object: {
                  expand: 'Ανάπτυξη',
                  collapse: 'Σύμπτυξη',
                },
                image: {
                  addMore: 'Προσθέστε περισσότερες εικόνες',
                  remove: 'Αφαίρεση εικόνας',
                  removeAll: 'Αφαίρεση όλων των εικόνων',
                },
                file: {
                  addMore: 'Προσθέστε περισσότερα αρχεία',
                  remove: 'Αφαίρεση αρχείου',
                  removeAll: 'Αφαίρεση όλων των αρχείων',
                },
              },
            },
            ui: {
              settingsDropdown: {
                account: 'Επιλογές λογαριασμού',
              },
              toast: {
                entrySaved: 'Η καταχώριση αποθηκεύτηκε',
                entryPublished: 'Η καταχώριση δημοσιεύτηκε',
                entryUnpublished: 'Η καταχώριση αποδημοσιεύτηκε',
                entryUpdated: 'Η κατάσταση ενημερώθηκε',
              },
            },
          });

          window.CMS.registerLocale('el', greekLocale);
        };

        const createPreviewTemplate = (renderFn) =>
          window.createClass({
            render() {
              return renderFn(this.props.entry.get('data'), this.props.getAsset);
            },
          });

        registerGreekLocale();
        window.CMS.registerPreviewStyle(previewStyleUrl);
        window.CMS.registerPreviewTemplate('site-global', createPreviewTemplate(renderSiteGlobalPreview));
        window.CMS.registerPreviewTemplate('hero', createPreviewTemplate(renderHeroPreview));
        window.CMS.registerPreviewTemplate('what-is', createPreviewTemplate(renderWhatIsPreview));
        window.CMS.registerPreviewTemplate('who-is-it-for', createPreviewTemplate(renderWhoIsItForPreview));
        window.CMS.registerPreviewTemplate('about', createPreviewTemplate(renderAboutPreview));
        window.CMS.registerPreviewTemplate('services', createPreviewTemplate(renderServicesPreview));
        window.CMS.registerPreviewTemplate('announcements', createPreviewTemplate(renderAnnouncementsPreview));
        window.CMS.registerPreviewTemplate('contact', createPreviewTemplate(renderContactPreview));
        window.initCMS({ config: { locale: 'el' } });
      };

      bootstrapAdmin();
    </script>
  </body>
</html>
