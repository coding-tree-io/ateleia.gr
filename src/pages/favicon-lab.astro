---
import PublicDocumentLayout from '@/layouts/PublicDocumentLayout.astro';
import { createProjectRelativeUrl } from '@/config/site-branding';

const pageTitle = 'Favicon Dashboard | Ateleia';
const pageDescription =
  'Review board for the approved Base B favicon and a small family of close render iterations.';

const liveSourceUrl = createProjectRelativeUrl('images/favicon-review/base-b-live-source.png');

const variants = [
  {
    key: 'orig',
    name: 'Original Balance',
    slug: 'original-balance',
    note: 'Pre-crop source.',
    detail: 'The approved Base B design before pushing it toward the edges of the favicon canvas.',
  },
  {
    key: '118',
    name: 'Crop 118%',
    slug: 'crop-118',
    note: 'First meaningful crop.',
    detail: 'A restrained scale-up that starts reducing the original empty margin.',
  },
  {
    key: '123',
    name: 'Crop 123%',
    slug: 'crop-123',
    note: 'Noticeably fuller.',
    detail: 'The symbol starts to command more of the square without feeling compressed.',
  },
  {
    key: '128',
    name: 'Crop 128%',
    slug: 'crop-128',
    note: 'Strong crop.',
    detail: 'A tighter crop that materially improves tab presence while keeping the rounded tile calm.',
  },
  {
    key: '133',
    name: 'Crop 133%',
    slug: 'crop-133',
    note: 'Near-max crop.',
    detail: 'The icon nearly fills the available canvas and starts to feel purpose-built for favicon usage.',
  },
  {
    key: '139',
    name: 'Live Crop 139%',
    slug: 'live-crop-139',
    note: 'Current production favicon set.',
    detail: 'The most aggressive clean crop in the set. This is now the live favicon direction.',
    isPrimary: true,
  },
].map((variant) => ({
  ...variant,
  preview16Url: createProjectRelativeUrl(`images/favicon-review/${variant.slug}-16.png`),
  preview32Url: createProjectRelativeUrl(`images/favicon-review/${variant.slug}-32.png`),
  preview64Url: createProjectRelativeUrl(`images/favicon-review/${variant.slug}-64.png`),
  preview128Url: createProjectRelativeUrl(`images/favicon-review/${variant.slug}-128.png`),
  preview512Url: createProjectRelativeUrl(`images/favicon-review/${variant.slug}-512.png`),
  icoUrl: createProjectRelativeUrl(`images/favicon-review/${variant.slug}.ico`),
}));

const liveVariant = variants.find((variant) => variant.isPrimary) ?? variants[0]!;
---

<PublicDocumentLayout
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  canonicalPath="favicon-lab/"
  robots="noindex, nofollow"
  includeCodingTreeAttributionScript={false}
>
  <main class="favicon-dashboard-page">
    <section class="favicon-dashboard-hero">
      <div>
        <p class="favicon-dashboard-kicker">Favicon Review</p>
        <h1>Base B, pushed to the edge of the canvas</h1>
      </div>
      <p class="favicon-dashboard-intro">
        This dashboard now focuses on one thing only: crop intensity. The approved Base B icon is compared
        against progressively tighter framings, with the most aggressive clean crop promoted to the live set.
      </p>
    </section>

    <section class="favicon-live-panel" aria-labelledby="live-source-title">
      <div class="favicon-section-heading">
        <p class="favicon-section-kicker">Current Source</p>
        <h2 id="live-source-title">Current live crop</h2>
      </div>
      <div class="favicon-live-grid">
        <div class="favicon-display-stage checkerboard-surface">
          <img src={liveSourceUrl} alt="Current approved Base B favicon source" width="256" height="256" />
        </div>
        <div class="favicon-live-copy">
          <p>
            This panel reflects the tightened production favicon. The comparison cards below step outward from
            the original balanced version toward this denser crop so you can judge how far the framing should go.
          </p>
          <div class="favicon-size-rail">
            <figure>
              <img src={liveVariant.preview16Url} alt="" width="16" height="16" />
              <figcaption>16</figcaption>
            </figure>
            <figure>
              <img src={liveVariant.preview32Url} alt="" width="32" height="32" />
              <figcaption>32</figcaption>
            </figure>
            <figure>
              <img src={liveVariant.preview64Url} alt="" width="64" height="64" />
              <figcaption>64</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <section class="favicon-variant-panel" aria-labelledby="variant-grid-title">
      <div class="favicon-section-heading">
        <p class="favicon-section-kicker">Iterations</p>
        <h2 id="variant-grid-title">Crop comparisons around the final design</h2>
      </div>

      <div class="favicon-variant-grid">
        {variants.map((variant) => (
          <article class:list={['favicon-variant-card', variant.isPrimary && 'is-primary']}>
            <header class="favicon-variant-header">
              <div>
                <p class="favicon-variant-kicker">{variant.note}</p>
                <h3>{variant.name}</h3>
                <p>{variant.detail}</p>
              </div>
              {variant.isPrimary && <span class="favicon-primary-badge">Live</span>}
            </header>

            <div class="favicon-display-stage checkerboard-surface is-compact">
              <img src={variant.preview128Url} alt={`${variant.name} large preview`} width="128" height="128" />
            </div>

            <div class="favicon-size-rail">
              <figure>
                <img src={variant.preview16Url} alt="" width="16" height="16" />
                <figcaption>16</figcaption>
              </figure>
              <figure>
                <img src={variant.preview32Url} alt="" width="32" height="32" />
                <figcaption>32</figcaption>
              </figure>
              <figure>
                <img src={variant.preview64Url} alt="" width="64" height="64" />
                <figcaption>64</figcaption>
              </figure>
            </div>

            <div class="favicon-render-stack">
              <div class="favicon-tab-preview">
                <p>Light tab bar</p>
                <div class="favicon-tab-strip is-light">
                  <div class="favicon-tab-item">Docs</div>
                  <div class="favicon-tab-item is-active">
                    <img src={variant.preview16Url} alt="" width="16" height="16" />
                    <span>Ατέλεια</span>
                  </div>
                  <div class="favicon-tab-item">Mail</div>
                </div>
              </div>

              <div class="favicon-tab-preview">
                <p>Dark tab bar</p>
                <div class="favicon-tab-strip is-dark">
                  <div class="favicon-tab-item">Docs</div>
                  <div class="favicon-tab-item is-active">
                    <img src={variant.preview16Url} alt="" width="16" height="16" />
                    <span>Ατέλεια</span>
                  </div>
                  <div class="favicon-tab-item">Mail</div>
                </div>
              </div>

              <div class="favicon-app-preview">
                <p>App tile</p>
                <div class="favicon-app-shell">
                  <img src={variant.preview64Url} alt="" width="64" height="64" />
                  <span>Ατέλεια</span>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</PublicDocumentLayout>

<style>
  :global(body) {
    margin: 0;
    background:
      radial-gradient(circle at top left, rgba(215, 127, 111, 0.11), transparent 28rem),
      linear-gradient(180deg, #fcf9f6 0%, #f6efe8 100%);
  }

  .favicon-dashboard-page {
    width: min(1200px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 2rem 0 4rem;
    display: grid;
    gap: 1.35rem;
  }

  .favicon-dashboard-hero,
  .favicon-live-panel,
  .favicon-variant-panel {
    border: 1px solid rgba(161, 72, 63, 0.14);
    border-radius: 1.5rem;
    background: rgba(255, 252, 249, 0.9);
    box-shadow: 0 18px 40px rgba(92, 64, 52, 0.08);
    padding: clamp(1rem, 2vw, 1.5rem);
  }

  .favicon-dashboard-hero {
    display: grid;
    gap: 0.75rem;
  }

  .favicon-dashboard-kicker,
  .favicon-section-kicker,
  .favicon-variant-kicker {
    margin: 0;
    color: #a1483f;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .favicon-dashboard-hero h1,
  .favicon-section-heading h2,
  .favicon-variant-header h3 {
    margin: 0;
    color: #3d3534;
    font-family: 'Cormorant Garamond', Georgia, serif;
    line-height: 0.98;
  }

  .favicon-dashboard-hero h1 {
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    max-width: 12ch;
  }

  .favicon-dashboard-intro,
  .favicon-live-copy p,
  .favicon-variant-header p,
  .favicon-tab-preview p,
  .favicon-app-preview p {
    margin: 0;
    color: #635855;
    line-height: 1.58;
  }

  .favicon-section-heading {
    display: grid;
    gap: 0.2rem;
  }

  .favicon-section-heading h2 {
    font-size: clamp(1.65rem, 3.6vw, 2.2rem);
  }

  .favicon-live-panel,
  .favicon-variant-panel {
    display: grid;
    gap: 1rem;
  }

  .favicon-live-grid {
    display: grid;
    grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
    gap: 1rem;
  }

  .favicon-live-copy {
    display: grid;
    align-content: center;
    gap: 0.85rem;
  }

  .checkerboard-surface {
    background-image:
      linear-gradient(45deg, rgba(61, 53, 52, 0.06) 25%, transparent 25%),
      linear-gradient(-45deg, rgba(61, 53, 52, 0.06) 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, rgba(61, 53, 52, 0.06) 75%),
      linear-gradient(-45deg, transparent 75%, rgba(61, 53, 52, 0.06) 75%);
    background-position: 0 0, 0 10px, 10px -10px, -10px 0;
    background-size: 20px 20px;
    background-color: #f8f3ef;
  }

  .favicon-display-stage {
    display: grid;
    place-items: center;
    min-height: 15rem;
    border-radius: 1.15rem;
    border: 1px solid rgba(161, 72, 63, 0.12);
    padding: 1rem;
  }

  .favicon-display-stage.is-compact {
    min-height: 10.5rem;
  }

  .favicon-display-stage img {
    max-width: 100%;
    height: auto;
  }

  .favicon-size-rail {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.8rem;
    border-radius: 0.95rem;
    border: 1px solid rgba(161, 72, 63, 0.11);
    background: rgba(255, 255, 255, 0.9);
  }

  .favicon-size-rail figure {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    color: #6b5f5c;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .favicon-variant-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .favicon-variant-card {
    display: grid;
    gap: 0.8rem;
    padding: 1rem;
    border-radius: 1.2rem;
    border: 1px solid rgba(161, 72, 63, 0.12);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(248, 243, 238, 0.96));
  }

  .favicon-variant-card.is-primary {
    border-color: rgba(199, 57, 46, 0.24);
    box-shadow: inset 0 0 0 1px rgba(199, 57, 46, 0.08);
  }

  .favicon-variant-header {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .favicon-variant-header > div {
    display: grid;
    gap: 0.3rem;
  }

  .favicon-primary-badge {
    display: inline-flex;
    align-items: center;
    height: 1.9rem;
    padding: 0 0.72rem;
    border-radius: 999px;
    background: rgba(199, 57, 46, 0.1);
    color: #8d4036;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .favicon-render-stack {
    display: grid;
    gap: 0.65rem;
  }

  .favicon-tab-preview,
  .favicon-app-preview {
    display: grid;
    gap: 0.35rem;
  }

  .favicon-tab-strip {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem;
    border-radius: 0.9rem;
    overflow: hidden;
  }

  .favicon-tab-strip.is-light {
    background: #ece7e1;
    color: #4a423f;
  }

  .favicon-tab-strip.is-dark {
    background: #312c2b;
    color: rgba(255, 248, 242, 0.82);
  }

  .favicon-tab-item {
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    padding: 0.4rem 0.5rem;
    border-radius: 0.72rem;
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .favicon-tab-item.is-active {
    background: rgba(255, 255, 255, 0.88);
    color: #3d3534;
    box-shadow: inset 0 0 0 1px rgba(61, 53, 52, 0.08);
  }

  .favicon-tab-strip.is-dark .favicon-tab-item.is-active {
    background: rgba(255, 255, 255, 0.12);
    color: #fff8f2;
  }

  .favicon-app-shell {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0.9rem;
    border-radius: 1rem;
    border: 1px solid rgba(161, 72, 63, 0.11);
    background: rgba(255, 255, 255, 0.9);
    color: #4f4543;
    font-weight: 700;
  }

  @media (max-width: 980px) {
    .favicon-variant-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .favicon-dashboard-page {
      width: min(100% - 1rem, 1200px);
      padding: 1rem 0 2.5rem;
    }

    .favicon-live-grid,
    .favicon-variant-grid {
      grid-template-columns: 1fr;
    }

    .favicon-tab-item:not(.is-active) {
      display: none;
    }
  }
</style>
