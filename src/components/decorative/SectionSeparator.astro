---
type Tone = 'ochre' | 'teal' | 'sage' | 'ink';
type Weight = 'after-hero' | 'standard' | 'compact';

interface Props {
  tone: Tone;
  weight?: Weight;
  inverted?: boolean;
  mirrored?: boolean;
  eager?: boolean;
}

const {
  tone,
  weight = 'standard',
  inverted = false,
  mirrored = false,
  eager = false,
} = Astro.props;

const dimensionsByTone: Record<Tone, { width: number; height: number }> = {
  ochre: { width: 2048, height: 326 },
  teal: { width: 2048, height: 262 },
  sage: { width: 2048, height: 250 },
  ink: { width: 2048, height: 235 },
};

const { width, height } = dimensionsByTone[tone];
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const basePath = `${baseUrl}images/section-separators/painted-separator-${tone}`;
const className = [
  'therapy-painted-separator',
  `therapy-painted-separator--${weight}`,
  `therapy-painted-separator--${tone}`,
  inverted ? 'therapy-painted-separator--inverted' : '',
  mirrored ? 'therapy-painted-separator--mirrored' : '',
]
  .filter(Boolean)
  .join(' ');
---

<div class={className} aria-hidden="true">
  <picture class="therapy-painted-separator__picture">
    <source srcset={`${basePath}.webp`} type="image/webp" />
    <img
      class="therapy-painted-separator__image"
      src={`${basePath}.png`}
      width={width}
      height={height}
      alt=""
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : 'auto'}
    />
  </picture>
</div>
